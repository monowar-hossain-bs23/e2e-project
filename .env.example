# Basha Pass Environment Variables

# Security
SECRET_KEY=django-insecure-change-me-in-production-basha-pass-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=sqlite:///db.sqlite3

# Email Backend (Optional in dev - defaults to console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
